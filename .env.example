# Guessr backend'inin ortam değişkenleri: yalnız adlar. Değerler repoda tutulmaz.
# Yerelde: bu dosyayı .env olarak kopyalayıp doldurun (.env git'e girmez).
# Production'da değerler Dokploy'da ("SKY LAB Etkinlik"); sırlar OpenBao referansıdır.

# Veritabanı (Postgres)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Sırlar
ADMIN_SECRET=
JWT_SECRET=

# Oyun ayarları
LOCATION_COUNT=
QUESTION_DURATION=
ALPHA_COEFFICIENT=
BETA_COEFFICIENT=
LEADERBOARD_PAGE_SIZE=

# CORS'ta izin verilen frontend adresi (ör. https://guessr.yildizskylab.com)
DOMAIN=

# Saklama ve imha (ADR-0062; README "Saklama ve imha")
# off | dry-run | apply (boşsa dry-run: yalnız sayar, değiştirmez)
RETENTION_SWEEP_MODE=
# Etkinliğin bitişi: 2025-05-18 (o günün sonu, Türkiye saati) ya da 2025-05-18T22:00:00+03:00.
# Boşsa iş hiçbir şeyi saymaz ve değiştirmez.
EVENT_ENDED_AT=
# Fren (boşsa 50000) ve tek komuttaki satır sayısı (boşsa 500)
RETENTION_SWEEP_MAX_ROWS=
RETENTION_SWEEP_BATCH_SIZE=
