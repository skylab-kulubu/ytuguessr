# Guessr backend'inin ortam değişkenleri: yalnız adlar. Değerler repoda tutulmaz.
# Yerelde: bu dosyayı .env olarak kopyalayıp doldurun (.env git'e girmez).
# Production'da değerler Dokploy'da ("SKY LAB Etkinlik"); sırlar OpenBao referansıdır.

# Veritabanı (Postgres)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Sırlar
ADMIN_SECRET=
JWT_SECRET=

# Oyun ayarları
LOCATION_COUNT=
QUESTION_DURATION=
ALPHA_COEFFICIENT=
BETA_COEFFICIENT=
LEADERBOARD_PAGE_SIZE=

# CORS'ta izin verilen frontend adresi (ör. https://guessr.yildizskylab.com)
DOMAIN=
